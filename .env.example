# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Read-only practice login, through Supabase's Session pooler.
# Copy the Session pooler string from Supabase (Connect button), then replace
# the user with sql_student.<project-ref> and the password with sql_student's.
DATABASE_URL=postgresql://sql_student.jmrpnfrwwirfucvdnjsv:YOUR-SQL-STUDENT-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Optional but recommended: Supabase's CA certificate (Database settings ->
# SSL Configuration -> Download certificate). Paste the whole PEM, including
# the BEGIN/END lines. When set, the server certificate is fully verified.
DATABASE_CA_CERT=

# The passcode she types to get into the app. Make it long.
APP_PASSCODE=

# Random secret used to sign the login cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
